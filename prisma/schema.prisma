// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
  // Set when this account belongs to an instructor (used by #35).
  instructor Instructor?
  // Materials this account shared (#26).
  materials  Material[]
}

model Course {
  id          Int     @id @default(autoincrement())
  courseCode  String  @unique
  courseName  String
  rating      Decimal @default(5.0)
  // Old M1 lists, no longer used after #25 (offerings replace them).
  // Kept for now because the live site's old code still asks for them
  // until the merge deploys. Drop both in a later migration.
  instructor  String[]
  semester    String[]
  offerings   Offering[]
}

// One person who teaches. userId links them to a site account (#35).
model Instructor {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  userId    Int?       @unique
  user      User?      @relation(fields: [userId], references: [id])
  offerings Offering[]
}

// One course, taught by one instructor, in one semester.
// "ICS 314, Fall 2026, two professors" is two Offering rows.
model Offering {
  id           Int        @id @default(autoincrement())
  semester     String
  courseId     Int
  course       Course     @relation(fields: [courseId], references: [id])
  instructorId Int
  instructor   Instructor @relation(fields: [instructorId], references: [id])
  // Materials shared for this class (#26).
  materials    Material[]

  @@unique([courseId, instructorId, semester])
}

// One shared link to course material (#26). We store links, never files.
// #33 lists these on course pages; #34 and #36 point at them.
model Material {
  id          Int      @id @default(autoincrement())
  title       String
  type        String // Notes, Study guide, ... (checked by the form rules)
  link        String // https only, from an allowed host
  description String   @default("")
  hidden      Boolean  @default(false) // #34's Remove sets this instead of deleting
  createdAt   DateTime @default(now())
  offeringId  Int // which class, term and instructor it belongs to
  offering    Offering @relation(fields: [offeringId], references: [id])
  uploaderId  Int // who shared it, taken from the session
  uploader    User     @relation(fields: [uploaderId], references: [id])
}
