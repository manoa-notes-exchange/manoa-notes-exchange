// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  INSTRUCTOR
  ADMIN
}

model User {
  id                Int         @id @default(autoincrement())
  email             String      @unique
  password          String
  role              Role        @default(USER)
  // Set when this account belongs to an instructor (used by #35).
  instructor        Instructor?
  // Materials this account shared (#26).
  materials         Material[]  @relation("UploadedMaterials")
  // Materials this account marked as outdated.
  outdatedMaterials Material[]  @relation("OutdatedMaterials")
  // Courses this account saved
  saved      Course[]
  bookmarks         Bookmark[]
}

model Course {
  id         Int        @id @default(autoincrement())
  courseCode String     @unique
  courseName String
  rating     Decimal    @default(5.0)
  // Old M1 lists, no longer used after #25 (offerings replace them).
  // Kept for now because the live site's old code still asks for them
  // until the merge deploys. Drop both in a later migration.
  instructor String[]
  semester   String[]
  offerings  Offering[]
  user       User[]
}

// One person who teaches. userId links them to a site account (#35).
model Instructor {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  userId    Int?       @unique
  user      User?      @relation(fields: [userId], references: [id])
  offerings Offering[]
}

// One course, taught by one instructor, in one semester.
// "ICS 314, Fall 2026, two professors" is two Offering rows.
model Offering {
  id           Int        @id @default(autoincrement())
  semester     String
  courseId     Int
  course       Course     @relation(fields: [courseId], references: [id])
  instructorId Int
  instructor   Instructor @relation(fields: [instructorId], references: [id])
  // Materials shared for this class (#26).
  materials    Material[]

  @@unique([courseId, instructorId, semester])
}

// One shared link to course material (#26). We store links, never files.
// #33 lists these on course pages; #34 and #36 point at them.
model Material {
  id          Int      @id @default(autoincrement())
  title       String
  type        String
  link        String
  description String   @default("")
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  offeringId Int
  offering   Offering @relation(fields: [offeringId], references: [id])

  uploaderId Int
  uploader   User @relation("UploadedMaterials", fields: [uploaderId], references: [id])

  outdatedNote   String?
  outdatedBy     Int?
  outdatedByUser User?      @relation("OutdatedMaterials", fields: [outdatedBy], references: [id], onDelete: SetNull)
  bookmarks      Bookmark[]
}

model Bookmark {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  userId     Int
  materialId Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
}
